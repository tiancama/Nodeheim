<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Nodeheim.Editor.MainWindow"
        xmlns:vm="clr-namespace:Nodeheim.Editor"
        x:DataType="vm:EditorViewModel"
        Title="Nodeheim.Editor">
    <ItemsControl ItemsSource="{Binding Nodes}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas Background="#FF9DC782" PointerPressed="OnCanvasPointerPressed"
                        PointerMoved="OnCanvasPointerMoved" PointerReleased="OnCanvasPointerReleased" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NodeViewModel">
                <Ellipse Width="30" Height="30" Fill="LightGray" Classes="node" Classes.selected="{Binding IsSelected}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>

        <ItemsControl.Styles>
            <Style Selector="ContentPresenter" x:DataType="vm:NodeViewModel">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>

            <Style Selector="Ellipse.node">
                <Setter Property="Stroke" Value="Gray" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>

            <Style Selector="Ellipse.node.selected">
                <Setter Property="Stroke" Value="CadetBlue" />
                <Setter Property="StrokeThickness" Value="4" />
            </Style>
        </ItemsControl.Styles>

    </ItemsControl>
</Window>
