<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Nodeheim.Editor.MainWindow"
        xmlns:vm="clr-namespace:Nodeheim.Editor"
        x:DataType="vm:EditorViewModel"
        Title="Nodeheim.Editor">
    <ItemsControl ItemsSource="{Binding Nodes}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas Background="#FF9DC782" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.Styles>
            <Style Selector="ContentPresenter" x:DataType="vm:NodeViewModel">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
        </ItemsControl.Styles>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NodeViewModel">
                <Ellipse Width="30" Height="30" Fill="LightGray" Stroke="CadetBlue" StrokeThickness="2" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>

    </ItemsControl>
</Window>
