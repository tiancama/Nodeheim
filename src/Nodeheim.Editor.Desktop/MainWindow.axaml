<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Nodeheim.Editor"
        xmlns:local="using:Nodeheim.Editor.Desktop"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Nodeheim.Editor.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Nodeheim.Editor">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="OnNewClick" />
                <MenuItem Header="_Quit" Click="OnQuitClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>
        <ContentControl Content="{Binding ActiveDocument}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:DocumentViewModel">
                    <local:DocumentView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>
</Window>
